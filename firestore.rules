rules_version = '2';
// Every record lives under /users/{uid}/... and ONLY that signed-in user can touch it.
// Changing a URL or an id can never reach another user's data: the path itself must match request.auth.uid.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function money(v)     { return v is number && v >= 0 && v < 100000000; }
    function amount(v)    { return v is number && v > -100000000 && v < 100000000; }   // balances may be negative (advance)
    function str(v, max)  { return v is string && v.size() <= max; }

    // quantity * rate of the i-th line (0 if the line does not exist). Unrolled because rules have no loops.
    function line(items, i) {
      return items.size() > i ? items[i].qty * items[i].rate : 0;
    }
    function itemsTotal(items) {
      return line(items,0)+line(items,1)+line(items,2)+line(items,3)+line(items,4)+line(items,5)
           + line(items,6)+line(items,7)+line(items,8)+line(items,9)+line(items,10)+line(items,11);
    }
    function validItem(it) {
      return it.qty is number && it.qty > 0 && it.qty < 1000000 && it.rate is number && it.rate >= 0 && it.rate < 10000000
          && str(it.itemId, 100) && str(it.name, 200);
    }
    // Server-side check of the money fields: totals must match the item lines, due must match, no negative payments.
    function validBill(d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(d.shopId, 100) && str(d.villageId, 100)
        && d.items is list && d.items.size() <= 12
        && (d.items.size() == 0 || (validItem(d.items[0]) && (d.items.size() < 2 || validItem(d.items[1])) && (d.items.size() < 3 || validItem(d.items[2]))
            && (d.items.size() < 4 || validItem(d.items[3])) && (d.items.size() < 5 || validItem(d.items[4])) && (d.items.size() < 6 || validItem(d.items[5]))
            && (d.items.size() < 7 || validItem(d.items[6])) && (d.items.size() < 8 || validItem(d.items[7])) && (d.items.size() < 9 || validItem(d.items[8]))
            && (d.items.size() < 10 || validItem(d.items[9])) && (d.items.size() < 11 || validItem(d.items[10])) && (d.items.size() < 12 || validItem(d.items[11]))))
        && money(d.presentTotal) && money(d.cash) && money(d.upi) && money(d.oldPaidCash) && money(d.oldPaidUpi) && money(d.oldDuePaid)
        && amount(d.todaysDue) && amount(d.prevDue) && amount(d.remaining)
        && math.abs(d.presentTotal - itemsTotal(d.items)) < 0.1                       // total must equal sum(qty*rate)
        && math.abs(d.todaysDue - (d.presentTotal - d.cash - d.upi)) < 0.02            // today's due formula
        && math.abs(d.oldDuePaid - (d.oldPaidCash + d.oldPaidUpi)) < 0.02
        && d.cash + d.upi <= d.presentTotal + 0.02                                     // old dues never hidden inside today's payments
        && str(d.notes, 500) && str(d.upiRef, 100);
    }

    match /users/{uid} {
      match /bills/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validBill(request.resource.data);
      }
      match /stock/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && money(request.resource.data.loaded) && money(request.resource.data.damaged);
      }
      match /shops/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && str(request.resource.data.name, 100) && amount(request.resource.data.openingBalance);
      }
      match /{coll}/{id} {   // villages, items, trips, images, audit, meta, settings – owner only
        allow read, write: if isOwner(uid) && coll in ['villages','items','trips','images','audit','meta','settings'];
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
